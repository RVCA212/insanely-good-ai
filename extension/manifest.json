{
  "manifest_version": 3,
  "name": "Insanely Good AI",
  "version": "0.1.0",
  "description": "Chat with Claude Code to change any website.",
  "key": "",
  "minimum_chrome_version": "138",
  "permissions": ["nativeMessaging", "sidePanel", "userScripts", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Insanely Good AI" },
  "side_panel": { "default_path": "panel.html" }
}
